diff --git a/arch/arm/boot/dts/st/stm32mp157d-dk1-can.dts b/arch/arm/boot/dts/st/stm32mp157d-dk1-can.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm/boot/dts/st/stm32mp157d-dk1-can.dts
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+#include "stm32mp157d-dk1.dts"
+
+&pinctrl {
+	m_can2_pins_dk1: m-can2-dk1-0 {
+		pins1 {
+			pinmux = <STM32_PINMUX('B', 6, AF9)>; /* FDCAN2_TX */
+			slew-rate = <1>;
+			drive-push-pull;
+			bias-disable;
+		};
+		pins2 {
+			pinmux = <STM32_PINMUX('B', 5, AF9)>; /* FDCAN2_RX */
+			bias-disable;
+		};
+	};
+
+	m_can2_sleep_pins_dk1: m-can2-dk1-sleep-0 {
+		pins {
+			pinmux = <STM32_PINMUX('B', 6, ANALOG)>,
+				 <STM32_PINMUX('B', 5, ANALOG)>;
+		};
+	};
+};
+
+&m_can2 {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&m_can2_pins_dk1>;
+	pinctrl-1 = <&m_can2_sleep_pins_dk1>;
+	status = "okay";
+};
